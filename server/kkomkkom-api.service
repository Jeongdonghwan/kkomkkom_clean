# /etc/systemd/system/kkomkkom-api.service 로 복사해서 사용
[Unit]
Description=kkomkkom quote API (Flask)
After=network.target mariadb.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/kkomkkom_clean/server
ExecStart=/var/www/kkomkkom_clean/server/venv/bin/gunicorn -w 2 -b 127.0.0.1:8787 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
